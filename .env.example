# Polkadot Asset Hub RPC endpoints
VITE_RPC_URL=wss://asset-hub-paseo-rpc.n.dwellir.com
VITE_RPC_FALLBACK_1=wss://sys.ibp.network/asset-hub-paseo
VITE_RPC_FALLBACK_2=wss://pas-rpc.stakeworld.io/assethub
VITE_RPC_FALLBACK_3=wss://asset-hub-paseo-rpc.dwellir.com

# Smart contract address (auto-generated by deploy script)
VITE_CONTRACT_ADDRESS=

# Network configuration
VITE_NETWORK=paseo-asset-hub
VITE_CHAIN_ID=420420417

# Game relay server URL (for cross-browser multiplayer, fallback)
VITE_RELAY_URL=ws://localhost:4001

# Substrate Statement Store RPC (for real-time game state sync)
VITE_STATEMENT_STORE_URL=wss://pop3-testnet.parity-lab.parity.io/people

# Game signing account is auto-generated and provisioned with Statement Store
# allowance via Alice's sudo on first use. The mnemonic is stored in localStorage.
