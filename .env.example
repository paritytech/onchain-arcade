# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# Inside a Polkadot host container (Desktop, Mobile, browser shell) the app
# NAMES its chain by genesis hash and the host owns the connection — the
# VITE_RPC_* endpoints below are not used there. They are the standalone
# (plain browser tab) path only.
#
# Genesis hash of the chain to read balances from. Defaults to paseo-asset-hub.
# Testnets get re-genesised: if the host answers "chain not supported", re-read
# the hash with chainSpec_v1_genesisHash and set it here.
VITE_CHAIN_GENESIS=

# DotNS TLD this network binds products under (`dot` for dot.li, `paseo` for
# paseo-next-v2). Resolved from VITE_CHAIN_GENESIS when left empty. Getting
# this wrong makes the host refuse the product account with DomainNotValid.
VITE_DOTNS_SUFFIX=

# Standalone-mode RPC endpoints (probed with PAPI's built-in failover).
VITE_RPC_URL=wss://asset-hub-paseo-rpc.n.dwellir.com
VITE_RPC_FALLBACK_1=wss://sys.ibp.network/asset-hub-paseo
VITE_RPC_FALLBACK_2=wss://pas-rpc.stakeworld.io/assethub

# ---------------------------------------------------------------------------
# Contract
# ---------------------------------------------------------------------------
# Smart contract address (auto-generated by the deploy script)
VITE_CONTRACT_ADDRESS=
VITE_NETWORK=paseo-asset-hub
VITE_CHAIN_ID=420420417

# ---------------------------------------------------------------------------
# Statement Store (game state)
# ---------------------------------------------------------------------------
# Standalone mode only: the raw Statement Store RPC the app signs against with
# its own key. In host mode the host provides the store and signs via the
# RFC-0010 StatementStoreAllowance — no URL and no key material here.
VITE_STATEMENT_STORE_URL=wss://pop3-testnet.parity-lab.parity.io/people

# Game relay server URL (legacy WebSocket fallback, currently unused)
VITE_RELAY_URL=ws://localhost:4001
